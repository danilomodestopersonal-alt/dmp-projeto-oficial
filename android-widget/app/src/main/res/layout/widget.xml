<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/background" android:orientation="vertical" android:padding="12dp">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="DMP — Hoje" android:textColor="#173D35" android:textSize="16sp" android:textStyle="bold"/><TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#65716B" android:textSize="12sp"/></LinearLayout>
